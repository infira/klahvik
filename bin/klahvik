#!/usr/bin/env php
<?php

use Infira\Console\Bin;
use Infira\Console\Exceptions\ConsoleRuntimeException;
use Infira\Klahvik\Config\Klahvik;
use Infira\Klahvik\ImportDbCommand;
use Infira\Klahvik\PhpStormCommand;
use Infira\Klahvik\RSyncCommand;
use Symfony\Component\Console\Application;
use Symfony\Component\Console\Input\ArgvInput;
use Symfony\Component\Console\Input\InputOption;
use Symfony\Component\Dotenv\Dotenv;
use Symfony\Component\Yaml\Yaml;
use Wolo\File\Path;

if (file_exists(__DIR__.'/../../../autoload.php')) {
    require __DIR__.'/../../../autoload.php';
}
else {
    require __DIR__.'/../vendor/autoload.php';
}
$klahvikPath = realpath(__DIR__.'/../').'/';

Bin::init([
        'traceFormatter' => static function (array $trace) {
            $file = $trace['file'] ?? '';
            $line = $trace['line'] ?? '';

            return "<href=phpstorm://open?file=$file&line=$line>$file:$line</>";
        }
]);
Bin::run('klahvik', static function (Application $app, ArgvInput $input) use ($klahvikPath) {
    // Register globally so options appear in --help and are accepted on every command.
    $app->getDefinition()->addOption(new InputOption(
            'env-file',
            'e',
            InputOption::VALUE_OPTIONAL,
            'Load env vars from a .env file. Use -e alone for ./.env in cwd, or --env-file=/path/to/.env for an explicit path.'
    ));
    $app->getDefinition()->addOption(new InputOption(
            'config',
            'c',
            InputOption::VALUE_REQUIRED,
            'Path to klahvik config file. Defaults to ./klahvik.yaml or ~/ws/dotfiles/.klahvik.yaml.'
    ));

    $configFile = $input->getParameterOption(['--config', '-c'], null, true);
    if ($configFile === null) {
        $possibleConfigFiles = [
                Path::join(getcwd(), 'klahvik.yaml'),
                Path::join(getcwd(), 'klahvik.yml'),
                Path::join($_SERVER['HOME'], '.klahvik/klahvik.yaml'),
                Path::join($_SERVER['HOME'], '.klahvik/klahvik.yml'),
        ];
        foreach ($possibleConfigFiles as $possibleConfigFile) {
            if (file_exists($possibleConfigFile)) {
                $configFile = $possibleConfigFile;
            }
        }
    }
    if (!$configFile) {
        throw new ConsoleRuntimeException("klahvik config is not defined. Use --c=/path/to/config.yaml");
    }
    if (!file_exists($configFile)) {
        throw new ConsoleRuntimeException("klahvik config file('$configFile') does not exists");
    }

    if ($input->hasParameterOption(['--env-file', '-e'], true)) {
        $envFile = $input->getParameterOption(['--env-file', '-e'], null, true)
                ?: Path::join(getcwd(), '.env');

        if (!file_exists($envFile)) {
            throw new ConsoleRuntimeException("env file('$envFile') does not exist");
        }
        new Dotenv()->usePutenv()->load($envFile);
    }

    $config = Yaml::parseFile($configFile);
    //replace .env variables from config
    array_walk_recursive($config, static function (mixed &$value): void {
        if (is_string($value)) {
            $value = preg_replace_callback(
                    '/\$\{([A-Z0-9_]+)}/',
                    static fn(array $m): string => getenv($m[1]) !== false ? getenv($m[1]) : $m[0],
                    $value
            );
        }
    });

    Klahvik::setConfig([
            ...$config,
            'klahvikPath' => $klahvikPath
    ]);

    foreach (Klahvik::getClientNames() as $name) {
        $app->addCommand(new ImportDbCommand($name));
        $app->addCommand(new PhpStormCommand($name));
        $app->addCommand(new RSyncCommand($name));
    }
});
